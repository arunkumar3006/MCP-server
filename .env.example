# ==========================================================
# Email MCP Server Configuration
# ==========================================================

# Default provider to use: auto | smtp | resend | sendgrid | mock
# If set to 'auto', it uses the first configured provider (Resend, SendGrid, or SMTP).
# If no provider credentials are configured, it safely defaults to 'mock' mode (logs to file).
DEFAULT_PROVIDER=auto

# Dry-run mode: set to 'true' to simulate sending without making real network calls
EMAIL_DRY_RUN=false

# Database path for persistent email jobs
DATABASE_PATH=emails.db

# How often (in seconds) the background worker checks for due emails
POLL_INTERVAL_SECONDS=5

# Optional: Set a specific timezone (e.g., 'America/New_York', 'Asia/Kolkata', 'UTC').
# Leave empty to use your system's local timezone.
TIMEZONE=

# ----------------------------------------------------------
# Option 1: Standard SMTP (Gmail, Outlook, Yahoo, Custom)
# ----------------------------------------------------------
# For Gmail: Use an App Password (not your normal Google password)
# Generated at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_DEFAULT_FROM=your_email@gmail.com

# ----------------------------------------------------------
# Option 2: Resend API (https://resend.com)
# ----------------------------------------------------------
RESEND_API_KEY=
RESEND_DEFAULT_FROM=onboarding@resend.dev

# ----------------------------------------------------------
# Option 3: SendGrid API (https://sendgrid.com)
# ----------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_DEFAULT_FROM=
